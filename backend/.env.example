DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
FRONTEND_ORIGIN=http://localhost:3000
# Clave para firmar los JWT (mínimo 32 caracteres). Usa una distinta en cada entorno.
JWT_SECRET=replace-this-development-secret-with-at-least-32-chars
# Opcional: publica Swagger (/swagger) fuera de Development. En desarrollo ya está activo.
# SWAGGER_ENABLED=true
# Opcional (HU7): LLM del asistente de recomendaciones. Sin clave se usa un asistente simulado, sin LLM.
# Sirve cualquier proveedor con API compatible con OpenAI. Ejemplo con Ollama (gratis, local; ver README):
# Configuración del equipo: OpenAI. La clave es privada: pídela por un medio privado y pégala solo aquí.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1/
# Modelo de texto del equipo (recomendaciones y chat del asistente).
# LLM_MODEL=gpt-6-luna
# Opcional: segundos máximos de espera al LLM (por defecto 20).
# LLM_TIMEOUT_SECONDS=30
#
# Alternativa local y gratis con Ollama (ver README):
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1/
# LLM_MODEL=qwen2.5:3b
# LLM_TIMEOUT_SECONDS=90
